# coturn для VoIP-звонков клиент ↔ курьер (тот же сервер, что и CRM).
# Установка: sudo apt install coturn; скопировать в /etc/turnserver.conf;
# в /etc/default/coturn раскомментировать TURNSERVER_ENABLED=1; sudo systemctl restart coturn
#
# Фаервол (ufw):
#   ufw allow 3478/udp && ufw allow 3478/tcp && ufw allow 5349/tcp
#   ufw allow 49160:49400/udp

listening-port=3478
tls-listening-port=5349

# Если сервер за NAT провайдера — указать публичный IP (или "публичный/приватный")
# external-ip=<PUBLIC_IP>

# Диапазон портов для relay. ~2 порта на звонок → хватает на ~120 одновременных звонков
min-port=49160
max-port=49400

# Временные учётки (TURN REST API). Значение должно совпадать с TURN_SECRET в .env CRM.
# Сгенерировать: openssl rand -hex 32
use-auth-secret
static-auth-secret=<TURN_SECRET>
realm=<TURN_DOMAIN>

# TLS (turns:) — нужен для сетей, где UDP закрыт. Сертификат можно взять от nginx/certbot.
cert=/etc/letsencrypt/live/<TURN_DOMAIN>/fullchain.pem
pkey=/etc/letsencrypt/live/<TURN_DOMAIN>/privkey.pem
no-tlsv1
no-tlsv1_1

fingerprint
stale-nonce=600
no-cli
no-multicast-peers
user-quota=4
total-quota=300

# БЕЗОПАСНОСТЬ: coturn стоит на одном сервере с CRM и MongoDB.
# Без этих запретов владелец TURN-учётки может проксировать трафик на localhost
# и во внутреннюю сеть (например, в MongoDB на 127.0.0.1:27017).
no-loopback-peers
denied-peer-ip=0.0.0.0-0.255.255.255
denied-peer-ip=10.0.0.0-10.255.255.255
denied-peer-ip=100.64.0.0-100.127.255.255
denied-peer-ip=127.0.0.0-127.255.255.255
denied-peer-ip=169.254.0.0-169.254.255.255
denied-peer-ip=172.16.0.0-172.31.255.255
denied-peer-ip=192.168.0.0-192.168.255.255
denied-peer-ip=::1
denied-peer-ip=fc00::-fdff:ffff:ffff:ffff:ffff:ffff:ffff:ffff
denied-peer-ip=fe80::-febf:ffff:ffff:ffff:ffff:ffff:ffff:ffff

log-file=/var/log/turnserver.log
simple-log
